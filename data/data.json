          "correctIndex": 0
        },
        {
          "id": "q-06",
          "prompt": "What is the standard structural formula for reporting mental states with these verbs?",
          "options": [
            "Subject + Verb + what + Subject + Verb",
            "Subject + Mental Verb + (that) + Subject + Verb",
            "Subject + Verb + Preposition + Object"
          ],
          "correctIndex": 1
        },
        {
          "id": "q-07",
          "prompt": "Is the word \"that\" required in spoken English when using these verbs?",
          "options": [
            "Yes, it is mandatory in all contexts",
