        {
          "id": "-P3x5hzjf-Acdu09CGdO",
          "prompt": "Which verb expresses 100% fact and certainty according to the degrees of certainty?",
          "options": [
            "Know",
            "Hope",
            "Think"
          ],
          "correctIndex": 0
        },
        {
          "id": "q-02",
          "prompt": "Which verb expresses an intuition or gut feeling based on experience?",
          "options": [
            "Feel",
            "Know",
            "Hope"
          ],
          "correctIndex": 0
        },
        {
          "id": "q-03",
          "prompt": "Which verb expresses a desire for a good future outcome?",
          "options": [
            "Think",
            "Believe",
            "Hope"
          ],
          "correctIndex": 2
        },
        {
          "id": "q-04",
          "prompt": "Which verb indicates an opinion or probability when something hasn't been tested yet?",
          "options": [
            "Know",
            "Think",
            "Prove"
          ],
          "correctIndex": 1
        },
        {
          "id": "q-05",
          "prompt": "Which verb shows high confidence or a strong opinion?",
          "options": [
            "Believe",
            "Hope",
            "Doubt"
